# ---- Runtime ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL ----
POSTGRES_USER=clearwell
POSTGRES_PASSWORD=clearwell_dev_password
POSTGRES_DB=clearwell
POSTGRES_PORT=5432
DATABASE_URL=postgres://clearwell:clearwell_dev_password@localhost:5432/clearwell

# ---- Secrets (placeholders only - never commit real values) ----
# Used to hash API keys before storage (HMAC-SHA256)
API_KEY_HASH_SECRET=change-me-in-production
# Admin JWT signing secret
JWT_SECRET=change-me-in-production
# HMAC secret the PSP simulator uses to sign callbacks to us
PSP_CALLBACK_SECRET=change-me-in-production
# HMAC secret we use to sign outbound merchant webhooks
WEBHOOK_SIGNING_SECRET=change-me-in-production

# ---- PSP simulator (separate process, simulated provider only) ----
PSP_PORT=4000
PSP_BASE_URL=http://127.0.0.1:4000
# Deadline for one provider call. Must stay small: the caller holds no DB lock,
# but a slow provider still blocks a request.
PSP_TIMEOUT_MS=3000
# Where the simulator POSTs async callbacks (signed with PSP_CALLBACK_SECRET)
PSP_CALLBACK_URL=http://127.0.0.1:3000/v1/internal/psp/callbacks
