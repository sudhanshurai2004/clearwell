{
  "name": "clearwell",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
